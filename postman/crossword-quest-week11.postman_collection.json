{
  "info": {
    "name": "Crossword Quest Week 11",
    "description": "Module 1: question sets. Run npm run db:reset, start the API, then Run collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Module 1: Question sets",
      "item": [
        {
          "name": "01 Host creates a set: 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Demo-User",
                "value": "2099-0001"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/question-sets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "question-sets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"{{setName}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"setName\", \"Postman Set \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test(\"body has id, name and host_id\", function () {",
                  "  pm.expect(json).to.have.property(\"id\");",
                  "  pm.expect(json.name).to.eql(pm.collectionVariables.get(\"setName\"));",
                  "});",
                  "pm.collectionVariables.set(\"setId\", json.id);",
                  "pm.collectionVariables.set(\"hostId\", json.host_id);"
                ]
              }
            }
          ]
        },
